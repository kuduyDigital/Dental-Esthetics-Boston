{
  "name": "dental-esthetics-boston-concept",
  "private": true,
  "scripts": {
    "vendor": "node -e \"require('fs').mkdirSync('vendor',{recursive:true});require('fs').copyFileSync('node_modules/lenis/dist/lenis.min.js','vendor/lenis.min.js')\"",
    "build": "npm run vendor && tailwindcss -i src/input.css -o dist/styles.css --minify",
    "dev": "npm run vendor && tailwindcss -i src/input.css -o dist/styles.css --watch"
  },
  "devDependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "lenis": "1.3.27"
  }
}
